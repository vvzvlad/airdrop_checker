# Copy to .env and fill in real values (`make env` does the copy).
# PLACEHOLDERS ONLY in this file — never commit a real credential.
# In production these come from `environment:` in the crypt-common stack on
# nebula, and there is no .env file at all.

# --- Grist ------------------------------------------------------------------
# Our own Grist deployment holding the Wallets and Settings tables. All three are
# REQUIRED and have no defaults in code: the address depends on the deployment,
# and a missing one must fail loudly at startup rather than silently point
# somewhere wrong.
GRIST_SERVER=https://grist.example.com
GRIST_DOC_ID=your_grist_doc_id_here
GRIST_API_KEY=your_grist_api_key_here

# --- Optional, shown commented out with their defaults -----------------------
# Liveness mark written by the loop and read by the Docker HEALTHCHECK probe.
# Changing these changes what auto-heal restarts the container on — the defaults
# are a production contract, override only if you know why.
#
# AND IF YOU DO OVERRIDE HEARTBEAT_FILE, DO IT IN THE ENVIRONMENT, NOT HERE.
# The two sides read it from different places: `src/settings.py` declares
# `env_file=".env"`, so the application picks up a value written in this file,
# while `src/healthcheck.py` reads the environment ONLY — deliberately, so a
# missing Grist credential cannot make the probe report "unhealthy" for a
# configuration reason. Put HEARTBEAT_FILE in .env alone and the loop marks one
# path while the probe watches another, so the container never leaves
# `unhealthy`. Production is unaffected — there is no .env there at all, and
# ci/smoke.py fails the build if one ever reaches the image — but locally it
# bites.
# HEARTBEAT_FILE=/tmp/airdrop_checker_heartbeat
# HEARTBEAT_MAX_AGE=1200

# Note what is NOT configured here. The proxy string, how many wallets a round
# takes and how long to wait between rounds live in the `Settings` table of the
# same Grist document, so the operator changes them without a redeploy.
