.env
.venv
venv/
__pycache__/
*.py[cod]
# Test-run artefacts, regenerated by `make test`.
.pytest_cache/
.coverage
htmlcov/
.DS_Store
# Runtime state directory: the directory is tracked (the image and the entrypoint
